<Window x:Class="StajApp.DocumentForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StajApp" xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
        mc:Ignorable="d"
        Title="DocumentForm" Height="450" Width="800">
    <Grid>
        <Label Content="Добавить документ" HorizontalAlignment="Left" Margin="22,26,0,0" VerticalAlignment="Top" Height="41" Width="140"/>
        <ComboBox HorizontalAlignment="Left" Margin="177,31,0,0" VerticalAlignment="Top" Width="223"/>
        <Label Content="Шаблоны документов" HorizontalAlignment="Left" Margin="22,90,0,0" VerticalAlignment="Top"/>
        <Grid Margin="31,0,214,0" Height="169" VerticalAlignment="Center"/>
        <Button Content="Распечать" HorizontalAlignment="Left" Margin="592,362,0,0" VerticalAlignment="Top" Height="46" Width="173"/>
        <ListView Name="docList" ItemsSource="{DynamicResource ResourceKey=docs}"  Margin="31,133,35,115">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Name}">Название </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=DateCreate}" Width="100">Дата создания</GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.Resources>
                <col:ArrayList x:Key="docs">
                    <local:DocType></local:DocType>
                </col:ArrayList>
            </ListView.Resources>
        </ListView>

    </Grid>
</Window>
