<Window x:Class="StajAppNet.NewSotrydnik"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StajAppNet"
        mc:Ignorable="d"
        Title="NewSotrydnik" Height="421" Width="360">
    <Grid Height="408" VerticalAlignment="Top">
        <Label Content="Ф.И.О." HorizontalAlignment="Left" Margin="30,29,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="109,29,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="231" Height="26"/>
        <Label Content="Дата рождения" HorizontalAlignment="Left" Margin="30,74,0,0" VerticalAlignment="Top"/>
        <DatePicker HorizontalAlignment="Left" Margin="224,76,0,0" VerticalAlignment="Top" Width="116"/>
        <Label Content="Пол" HorizontalAlignment="Left" Margin="30,117,0,0" VerticalAlignment="Top"/>
        <RadioButton Content="Мужской" HorizontalAlignment="Left" Margin="154,123,0,0" VerticalAlignment="Top"/>
        <RadioButton Content="Женский" HorizontalAlignment="Left" Margin="255,123,0,0" VerticalAlignment="Top"/>
        <ListView x:Name="sotrudnikList_Копировать" Margin="30,182,0,99" MouseLeftButtonUp="MouseClick" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="sotrudnikList_SelectionChanged" HorizontalAlignment="Left" Width="310">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Fio}" Width="80" Header="Организация"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Dater}" Width="80" Header="Должность"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Pol}" Width="100" Header="Муниципалитет"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Age}" Width="80" Header="Дата найма"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Age}" Width="100" Header="Дата увольнения"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Отмена" HorizontalAlignment="Left" Margin="255,355,0,0" VerticalAlignment="Top" Height="25" Width="85"/>
        <Button Content="Добавить" HorizontalAlignment="Left" Margin="147,355,0,0" VerticalAlignment="Top" Height="25" Width="85"/>
    </Grid>
</Window>
